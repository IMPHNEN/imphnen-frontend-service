---
import Public from '../layouts/Public.astro';
import LoginForm from '../components/LoginForm';
---

<Public title="Login - IMPHNEN">
  <div style="position: relative; min-height: calc(100vh - 5rem); display: flex; align-items: center; justify-content: center; padding: 3rem 1rem; overflow: hidden; background: #f8fbff;">
    <div style="position: absolute; inset: 0; pointer-events: none; z-index: 0;">
      <div style="position: absolute; top: 20%; left: 50%; transform: translateX(-50%); width: 600px; height: 600px; border-radius: 50%; background: radial-gradient(circle, rgba(35,161,235,0.12) 0%, transparent 70%);"></div>
      <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-image: linear-gradient(rgba(59,130,246,0.04) 1px, transparent 1px), linear-gradient(to right, rgba(59,130,246,0.04) 1px, transparent 1px); background-size: 40px 40px;"></div>
      <div style="position: absolute; bottom: 10%; right: 5%; width: 300px; height: 300px; border-radius: 50%; background: radial-gradient(circle, rgba(8,119,193,0.08) 0%, transparent 70%);"></div>
    </div>

    <div style="position: relative; z-index: 1; width: 100%; max-width: 420px;">
      <div style="background: #ffffff; border-radius: 24px; padding: 2.5rem 2rem; box-shadow: 0 8px 40px rgba(35,161,235,0.12), 0 2px 12px rgba(0,0,0,0.06); border: 1px solid rgba(35,161,235,0.15);">
        <div style="text-align: center; margin-bottom: 2rem;">
          <a href="/" style="display: inline-block; margin-bottom: 1rem; transition: transform 0.2s;">
            <img src="/logo.webp" alt="IMPHNEN" style="width: 96px; height: auto; object-fit: contain; margin: 0 auto;" />
          </a>
          <h1 style="font-size: 1.5rem; font-weight: 700; color: #0a2b47; margin: 0 0 0.375rem 0; letter-spacing: -0.02em;">Selamat Datang Kembali</h1>
          <p style="font-size: 0.875rem; color: #888; margin: 0;">Masuk ke akun IMPHNEN Anda untuk melanjutkan</p>
        </div>

        <LoginForm client:load />
      </div>

      <p style="text-align: center; font-size: 0.75rem; color: #bbb; margin-top: 1.5rem;">
        &copy; {new Date().getFullYear()} IMPHNEN. All rights reserved.
      </p>
    </div>
  </div>
</Public>
