---
import navigations from '../data/navigations.json';
import MobileMenu from './MobileMenu';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 w-full z-50 bg-background/80 backdrop-blur-md border-b border-border/40">
  <div class="container flex h-20 items-center justify-between gap-4">
    <a href="/" class="relative overflow-hidden rounded z-50 shrink-0 flex items-center" aria-label="Home">
      <img src="/logo.webp" alt="IMPHNEN" class="w-24 md:w-28 h-auto object-contain" />
    </a>

    <nav class="hidden md:flex items-center justify-center gap-4 lg:gap-8 flex-1 px-4">
      {navigations.map(({ link, title }: { link: string; title: string }) => (
        <a
          href={link}
          class:list={[
            'text-xs lg:text-sm font-medium relative group px-2 py-2 transition-colors',
            currentPath === link ? 'text-primary' : 'text-foreground/80 hover:text-primary',
          ]}
        >
          <span class="block">{title}</span>
          {currentPath === link && (
            <span class="absolute bottom-0 left-0 w-full h-0.5 bg-primary rounded-full" />
          )}
        </a>
      ))}
    </nav>

    <!-- Balanced placeholder for logo width on desktop -->
    <div class="hidden md:block w-24 md:w-28 shrink-0"></div>

    <div class="md:hidden ml-auto">
      <MobileMenu client:idle navigations={navigations} currentPath={currentPath} />
    </div>
  </div>
</header>
